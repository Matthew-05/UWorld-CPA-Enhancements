{
  "manifest_version": 3,
  "name": "UWorld Enhancements",
  "version": "1.1.0",
  "description": "Peer-average score marker, result-colored question review navigation, and restored Ctrl+F, text selection and copy for UWorld.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UWorld Enhancements",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://apps.uworld.com/*",
        "https://*.uworld.com/*"
      ],
      "js": [
        "features.js",
        "find-unblock.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://apps.uworld.com/*",
        "https://*.uworld.com/*"
      ],
      "js": [
        "features.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://apps.uworld.com/*",
        "https://*.uworld.com/*"
      ],
      "js": [
        "features.js",
        "review-nav.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
